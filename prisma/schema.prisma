// NOD data model — docs/04-data-model.md
// Money is always Int in öre (SEK x 100). Never float, never Decimal.
// Every table has createdAt / updatedAt / deletedAt (soft delete only, CLAUDE.md rule 9).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DECISION: named after what the Vercel Neon integration injects, so a deploy needs no
  // env renaming. Supabase's integration calls it POSTGRES_URL_NON_POOLING (docs/12).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------- enums
// Enums mirror docs/03-workflows.md exactly.

enum Role {
  PARTICIPANT
  BRAND
  OPS
}

enum ParticipantState {
  SIGNED_UP
  ONBOARDED
  VERIFIED
  ACTIVE
  FLAGGED
  SUSPENDED
  REMOVED
}

enum AccountPlatform {
  INSTAGRAM
  TIKTOK
}

enum AccountTier {
  CONNECTED_API
  CONNECTED_SCREENSHOT
  BELOW_FLOOR
  DISCONNECTED
}

enum CampaignState {
  DRAFT
  SUBMITTED
  RETURNED
  AWAITING_FUNDS
  FUNDED
  LIVE
  FILLING
  EXHAUSTED
  EXPIRED
  PAUSED
  RECONCILING
  CLOSED
}

enum CampaignKind {
  PLACEMENT // AI product placement (docs/02-03)
  CLIP // creators' own posts, CPM on validated views (docs/14)
}

enum MembershipState {
  JOINED
  LEFT
  SUSPENDED
  BLOCKED
}

enum SubmissionState {
  RECEIVED
  FIX_DISCLOSURE
  TRACKING
  VALIDATING
  HELD
  QUALIFIED
  PAID
  REJECTED
}

enum SubmissionRejectReason {
  NOT_OWNER
  NOT_FOUND
  OUTSIDE_WINDOW
  NO_DISCLOSURE
  DELETED_EARLY
  FRAUD
  OPS_REJECTED
  DUPLICATE
}

enum ReviewTier {
  A
  B
}

enum PayoutKind {
  FIXED
  CPM
  HYBRID
  HYBRID_BONUS
}

enum PlacementState {
  CLAIMED
  UPLOADED
  POSITIONED
  GENERATING
  GENERATION_FAILED
  PARTICIPANT_REVIEW
  BRAND_REVIEW
  APPROVED
  PUBLISHED
  VERIFYING
  FLAGGED
  QUALIFIED
  PAID
  REJECTED
  EXPIRED
  REJECTED_BY_PARTICIPANT
  REJECTED_BY_BRAND
  DISPUTED
}

enum RejectReason {
  NO_DISCLOSURE
  MEDIA_MISMATCH
  WRONG_ACCOUNT
  DELETED_EARLY
  FRAUD
  BRAND_SAFETY
  OTHER
}

enum LedgerType {
  DEPOSIT
  RESERVE
  RELEASE_RESERVATION
  SETTLE
  PAYOUT_ACCRUE
  TAKE
  PAYOUT_SENT
  REFUND
  ROLLOVER
  CREDIT_TERMS_FEE
  ADJUSTMENT
}

enum StrikeSeverity {
  MINOR
  SERIOUS
}

enum DisputeState {
  OPEN
  UPHELD
  REJECTED
}

enum PayoutBatchState {
  OPEN
  EXPORTED
  SETTLED
}

// ---------------------------------------------------------------- people

model User {
  id                  String           @id @default(cuid())
  authId              String           @unique
  email               String?
  role                Role             @default(PARTICIPANT)
  state               ParticipantState @default(SIGNED_UP)
  locale              String           @default("sv")
  city                String?
  ageBracket          String?
  swishNumber         String? // E.164, AES-256-GCM encrypted at rest
  trainingConsent     Boolean          @default(false)
  disclosureQuizAt    DateTime?
  termsAcceptedAt     DateTime?
  pushSubscription    Json?
  smsOptIn            Boolean          @default(false)
  referralCode        String           @unique
  referredById        String?
  reputation          Int              @default(0)
  onboardingStep      Int              @default(1)
  deletionRequestedAt DateTime?

  identity    Identity?
  accounts    SocialAccount[]
  wallet      Wallet?
  placements  Placement[]
  memberships CampaignMembership[]
  submissions Submission[]
  strikes     Strike[]

  referredBy       User?      @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers    User[]     @relation("UserReferrals")
  referralsMade    Referral[] @relation("ReferralReferrer")
  referralReceived Referral?  @relation("ReferralReferred")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([state])
  @@index([referredById])
}

// BankID — minimum data. Personnummer is NEVER stored (docs/07 section 3).
model Identity {
  id          String   @id @default(cuid())
  userId      String   @unique
  subjectHash String   @unique // sha256(provider subject + BANKID_SUBJECT_SALT)
  birthYear   Int
  verifiedAt  DateTime
  provider    String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model SocialAccount {
  id             String          @id @default(cuid())
  userId         String
  platform       AccountPlatform
  handle         String
  platformUserId String
  tier           AccountTier
  accountType    String? // personal | creator | business
  isPrivate      Boolean         @default(false)
  followers      Int             @default(0)
  avgViews30d    Int             @default(0)
  categories     String[]        @default([])
  accessToken    String? // encrypted
  refreshToken   String? // encrypted
  tokenExpiresAt DateTime?
  lastSyncedAt   DateTime?
  disconnectedAt DateTime?

  user        User                    @relation(fields: [userId], references: [id])
  placements  Placement[]
  submissions Submission[]
  snapshots   SocialAccountSnapshot[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([platform, platformUserId])
  @@index([userId])
}

/**
 * One row per analytics sync — the follower / view history behind the "your accounts"
 * page. Aggregates only (docs/07): no per-post rows, no audience demographics.
 */
model SocialAccountSnapshot {
  id          String   @id @default(cuid())
  accountId   String
  followers   Int
  avgViews30d Int
  posts30d    Int      @default(0)
  capturedAt  DateTime @default(now())

  account SocialAccount @relation(fields: [accountId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([accountId, capturedAt])
}

model Strike {
  id          String         @id @default(cuid())
  userId      String
  severity    StrikeSeverity
  reason      String
  placementId String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

model Referral {
  id               String    @id @default(cuid())
  referrerId       String
  referredId       String    @unique
  firstPlacementAt DateTime?
  bonusPaidAt      DateTime?

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referred User @relation("ReferralReferred", fields: [referredId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([referrerId])
}

// ---------------------------------------------------------------- brands

model Brand {
  id                 String  @id @default(cuid())
  name               String
  orgNumber          String?
  stripeCustomerId   String?
  invoiceWhitelisted Boolean @default(false)
  rolloverPreference String  @default("refund") // refund | rollover

  users     BrandUser[]
  campaigns Campaign[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model BrandUser {
  id      String  @id @default(cuid())
  brandId String
  authId  String  @unique
  email   String
  name    String?
  role    String  @default("member") // admin | member

  brand Brand @relation(fields: [brandId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([brandId])
}

model Campaign {
  id        String        @id @default(cuid())
  brandId   String
  name      String
  kind      CampaignKind  @default(PLACEMENT)
  state     CampaignState @default(DRAFT)
  objective String        @default("awareness")
  startsAt  DateTime?
  endsAt    DateTime?
  goLiveAt  DateTime?

  // audience
  countries    String[] @default(["SE"])
  cities       String[] @default([])
  ageBrackets  String[] @default([])
  minFollowers Int      @default(300)
  maxFollowers Int?
  categories   String[] @default([])
  exclusions   String[] @default([])

  // rules
  rulesText      String?
  brandSafety    String[]   @default([])
  reviewTier     ReviewTier @default(B)
  disclosureText String     @default("Reklam – i samarbete med {brand}")
  perPersonCap   Int        @default(2) // placements, or submissions for CLIP, per participant

  // clip rules (docs/14) — ignored for PLACEMENT campaigns
  platforms           AccountPlatform[] @default([INSTAGRAM, TIKTOK])
  joinCap             Int?
  validationHours     Int               @default(168)
  requiredHashtags    String[]          @default([])
  requiredMentions    String[]          @default([])
  joinsPausedAt       DateTime?
  submissionsPausedAt DateTime?

  // money (öre)
  budget            Int     @default(0)
  perPlacementMax   Int     @default(50000)
  fundedVia         String? // card | invoice
  creditTermsFeeBps Int     @default(0)

  // lifecycle bookkeeping
  submittedAt         DateTime?
  returnedNotes       String?
  fundedAt            DateTime?
  liveAt              DateTime?
  exhaustedAt         DateTime?
  reopenedAt          DateTime?
  reconcilingAt       DateTime?
  closedAt            DateTime?
  pausedAt            DateTime?
  disputeWindowEndsAt DateTime?
  stripeSessionId     String?
  reportPath          String?

  brand          Brand                @relation(fields: [brandId], references: [id])
  payoutTemplate PayoutTemplate?
  assets         CampaignAsset[]
  placements     Placement[]
  memberships    CampaignMembership[]
  submissions    Submission[]
  ledger         LedgerEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([brandId, state])
  @@index([state, goLiveAt])
  @@index([kind, state])
}

// Brand-facing (all-in) numbers. Participant share is derived via take rate.
model PayoutTemplate {
  id           String     @id @default(cuid())
  campaignId   String     @unique
  kind         PayoutKind
  fixedOre     Int        @default(0)
  cpmOre       Int        @default(0)
  bonusAtViews Int?
  bonusOre     Int?
  viewFloor    Int        @default(100)
  takeRateBps  Int        @default(2800) // snapshot at funding; never changed after

  campaign Campaign @relation(fields: [campaignId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model CampaignAsset {
  id             String   @id @default(cuid())
  campaignId     String
  name           String
  storagePath    String
  placementTypes String[] @default([])

  campaign Campaign @relation(fields: [campaignId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([campaignId])
}

// ---------------------------------------------------------------- placements

model Placement {
  id              String         @id @default(cuid())
  campaignId      String
  userId          String
  socialAccountId String
  state           PlacementState @default(CLAIMED)
  rejectReason    RejectReason?
  rejectNote      String?
  reservationOre  Int
  claimedAt       DateTime       @default(now())
  deadlineAt      DateTime
  clockPausedAt   DateTime?
  pausedMs        Int            @default(0)

  contentType      String? // story | reel | post
  originalPath     String?
  originalHash     String? // perceptual hash: duplicates + media match
  regionJson       Json?
  assetId          String?
  regenCount       Int     @default(0)
  currentVersionId String?

  postUrl              String?
  postPlatformId       String?
  publishedAt          DateTime?
  holdEndsAt           DateTime?
  disclosureTextIssued String?
  disclosureToken      String?   @unique
  fixWindowEndsAt      DateTime?
  brandSampled         Boolean   @default(false)
  settledAt            DateTime?
  paidAt               DateTime?

  campaign     Campaign           @relation(fields: [campaignId], references: [id])
  user         User               @relation(fields: [userId], references: [id])
  account      SocialAccount      @relation(fields: [socialAccountId], references: [id])
  versions     PlacementVersion[]
  events       PlacementEvent[]
  verification Verification?
  dispute      Dispute?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([campaignId, state])
  @@index([userId, state])
  @@index([deadlineAt])
  @@index([holdEndsAt])
  @@index([originalHash])
}

model PlacementVersion {
  id          String @id @default(cuid())
  placementId String
  storagePath String
  engine      String
  params      Json?

  placement Placement @relation(fields: [placementId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([placementId])
}

// Training signal — docs/06 section 6, docs/07 section 2
model PlacementEvent {
  id          String @id @default(cuid())
  placementId String
  type        String // CANDIDATES_SHOWN | REGION_PICKED | REGEN | MOVE | SWAP | APPROVE | REJECT_P | REJECT_B | BRAND_SAMPLE_OK
  payload     Json

  placement Placement @relation(fields: [placementId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([placementId, type])
}

model Verification {
  id             String    @id @default(cuid())
  placementId    String    @unique
  accountMatch   Boolean?
  disclosureOk   Boolean?
  labelOk        Boolean?
  mediaMatch     Float?
  views          Int?
  viewsSource    String? // api | screenshot
  screenshotPath String?
  fraudScore     Float?
  fraudFactors   Json?
  geoFactor      Float     @default(1)
  qualifiedViews Int?
  decidedBy      String? // system | ops:<id>
  decidedAt      DateTime?
  attempt        Int       @default(1)

  placement Placement      @relation(fields: [placementId], references: [id])
  snapshots ViewSnapshot[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model ViewSnapshot {
  id             String   @id @default(cuid())
  verificationId String
  at             DateTime @default(now())
  views          Int
  reach          Int?
  source         String

  verification Verification @relation(fields: [verificationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([verificationId])
}

model Dispute {
  id          String       @id @default(cuid())
  placementId String       @unique
  state       DisputeState @default(OPEN)
  raisedBy    String
  reason      String
  resolution  String?
  resolvedAt  DateTime?

  placement Placement @relation(fields: [placementId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ---------------------------------------------------------------- money

/// A creator's seat in a CLIP campaign (docs/14 §2). Join is a DB-only write.
model CampaignMembership {
  id         String          @id @default(cuid())
  campaignId String
  userId     String
  state      MembershipState @default(JOINED)
  joinedAt   DateTime        @default(now())
  leftAt     DateTime?
  note       String?

  campaign    Campaign     @relation(fields: [campaignId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  submissions Submission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([campaignId, userId])
  @@index([userId, state])
  @@index([campaignId, state])
}

/// One submitted post in a CLIP campaign (docs/14 §2-5). Money columns are the reservation
/// only; what was actually paid lives in the ledger.
model Submission {
  id              String                  @id @default(cuid())
  campaignId      String
  membershipId    String
  userId          String
  socialAccountId String
  platform        AccountPlatform
  state           SubmissionState         @default(RECEIVED)
  rejectReason    SubmissionRejectReason?
  rejectNote      String?

  // the post
  postId          String // platform id parsed from the URL (TikTok video id, Instagram shortcode)
  providerMediaId String? // id the provider API uses when it differs (Instagram numeric media id)
  canonicalUrl    String
  caption         String?
  publishedAt     DateTime?

  // metrics — mirrors of the latest snapshot for cheap dashboards; snapshots are the truth
  initialViews   Int       @default(0)
  latestViews    Int       @default(0)
  eligibleViews  Int       @default(0)
  latestLikes    Int       @default(0)
  latestComments Int       @default(0)
  latestShares   Int       @default(0)
  lastCheckedAt  DateTime?

  // money (öre) — see docs/14 D2
  reservationOre  Int     @default(0)
  budgetExhausted Boolean @default(false)

  // tracking schedule
  nextCheckAt         DateTime?
  queuedAt            DateTime?
  priority            Int       @default(0)
  consecutiveFailures Int       @default(0)
  consecutiveMissing  Int       @default(0)
  trackingPausedAt    DateTime?

  // risk
  riskScore   Int?
  riskFactors String[] @default([])

  // lifecycle
  submittedAt      DateTime  @default(now())
  fixWindowEndsAt  DateTime?
  validationEndsAt DateTime?
  settledAt        DateTime?
  paidAt           DateTime?

  campaign   Campaign             @relation(fields: [campaignId], references: [id])
  membership CampaignMembership   @relation(fields: [membershipId], references: [id])
  user       User                 @relation(fields: [userId], references: [id])
  account    SocialAccount        @relation(fields: [socialAccountId], references: [id])
  snapshots  SubmissionSnapshot[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([campaignId, platform, postId])
  @@index([campaignId, state])
  @@index([userId, state])
  @@index([state, nextCheckAt])
  @@index([state, validationEndsAt])
  @@index([state, fixWindowEndsAt])
  @@index([socialAccountId])
}

/// One metrics observation. `bucket` is floor(observedAt / 5 min): a replayed job writes
/// the same bucket and hits the unique constraint instead of duplicating.
model SubmissionSnapshot {
  id           String   @id @default(cuid())
  submissionId String
  observedAt   DateTime @default(now())
  bucket       Int
  views        Int
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)

  submission Submission @relation(fields: [submissionId], references: [id])

  deletedAt DateTime?

  @@unique([submissionId, bucket])
  @@index([submissionId, observedAt])
}

model Wallet {
  id     String @id @default(cuid())
  userId String @unique

  user    User          @relation(fields: [userId], references: [id])
  entries LedgerEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Append-only. Never updated, never deleted. Balances are sums (docs/04 Derived numbers).
model LedgerEntry {
  id           String     @id @default(cuid())
  type         LedgerType
  amountOre    Int
  campaignId   String?
  walletId     String?
  placementId  String?
  submissionId String?
  batchId      String?
  memo         String?
  externalRef  String?    @unique

  campaign Campaign?    @relation(fields: [campaignId], references: [id])
  wallet   Wallet?      @relation(fields: [walletId], references: [id])
  batch    PayoutBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())

  @@index([campaignId, type])
  @@index([walletId, type])
  @@index([placementId])
  @@index([submissionId])
}

model PayoutBatch {
  id         String           @id @default(cuid())
  state      PayoutBatchState @default(OPEN)
  exportedAt DateTime?
  settledAt  DateTime?
  totalOre   Int              @default(0)
  note       String?

  entries LedgerEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ---------------------------------------------------------------- marketing

/// The pre-launch queue (docs/13). Rank is derived: order by points desc, createdAt asc.
/// `position` is the join order and never changes; `points` is a cached sum of
/// WaitlistPoint rows, updated in the same transaction as the row that explains it.
model WaitlistEntry {
  id               String           @id @default(cuid())
  email            String
  phone            String?
  city             String
  /// Profile completion — asked for after joining, each worth points (docs/13 section 3).
  displayName      String?
  handle           String?
  platform         AccountPlatform?
  ageBracket       String?
  followersBracket String?
  categories       String[]         @default([])

  referralCode String  @unique
  /// The referrer's referralCode. Counted only once this entry verifies (docs/13 section 5).
  referredBy   String?

  /// Join order, 1-based. Kept as "you were #317 in line" and as the final tiebreak.
  position          Int @default(0)
  points            Int @default(0)
  verifiedReferrals Int @default(0)
  level             Int @default(0)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  /// First of the two above — the moment a referral through this entry counts.
  verifiedAt      DateTime?
  priorityAt      DateTime?
  accessGrantedAt DateTime?
  accessExpiresAt DateTime?
  convertedUserId String?

  /// Consent is recorded per purpose (docs/07): the waitlist itself, and SMS about it.
  consentAt          DateTime
  smsConsentAt       DateTime?
  marketingConsentAt DateTime?
  smsOptOutAt        DateTime?
  lastSmsAt          DateTime?
  /// Rank at the last SMS, so the next one can say how far they moved.
  lastNotifiedRank   Int?
  lastActiveAt       DateTime?

  signupSource String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  /// HMAC of the signup IP — abuse signal only, never the address itself.
  ipHash       String?

  pointsLedger WaitlistPoint[]
  events       WaitlistEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([phone])
  @@index([referredBy])
  @@index([ipHash])
  @@index([points(sort: Desc), createdAt])
  @@index([city, verifiedAt])
}

/// Append-only: why an entry has the points it has.
model WaitlistPoint {
  id        String        @id @default(cuid())
  entry     WaitlistEntry @relation(fields: [entryId], references: [id])
  entryId   String
  amount    Int
  reason    String
  /// The thing the points are for (a referred entry id, a boost id), so it is awarded once.
  refId     String?
  createdAt DateTime      @default(now())

  @@unique([entryId, reason, refId])
  @@index([entryId])
}

enum WaitlistEventType {
  SIGNED_UP
  EMAIL_VERIFIED
  PHONE_VERIFIED
  PROFILE_COMPLETED
  FRIEND_JOINED
  FRIEND_VERIFIED
  RANK_CHANGED
  LEVEL_UNLOCKED
  REWARD_UNLOCKED
  ACCESS_GRANTED
  ACCESS_USED
}

/// What happened to an entry, in order. The SMS digest reads rows with notifiedAt null
/// (docs/13 section 4); the queue page shows the last few.
model WaitlistEvent {
  id         String            @id @default(cuid())
  entry      WaitlistEntry     @relation(fields: [entryId], references: [id])
  entryId    String
  type       WaitlistEventType
  data       Json?
  notifiedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([entryId, createdAt])
  @@index([notifiedAt, createdAt])
}

/// One-time SMS code for verifying a waitlist phone number (lib/queue.ts).
model PhoneCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model BrandEnquiry {
  id            String  @id @default(cuid())
  company       String
  name          String
  email         String
  budgetBracket String
  objective     String?
  message       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ---------------------------------------------------------------- system

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  fromState String?
  toState   String?
  event     String
  actor     String
  reason    String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Flag {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// One-time sign-in code (lib/login.ts). The code itself is never stored — only an HMAC of
/// it — and a row is consumed on first success, so a code cannot be replayed.
model LoginCode {
  id         String        @id @default(cuid())
  email      String
  audience   LoginAudience
  codeHash   String
  attempts   Int           @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?

  @@index([email, audience, createdAt])
}

enum LoginAudience {
  PARTICIPANT
  BRAND
}

model IdempotencyKey {
  key       String   @id
  scope     String
  createdAt DateTime @default(now())

  @@index([scope])
}
