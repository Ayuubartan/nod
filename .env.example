# ---- Core ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (Supabase Postgres, EU region) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nod?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nod?schema=public"

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nod-media"

# ---- Providers: when a key is absent the fake implementation is used ----
# Set NOD_FAKE_PROVIDERS=1 to force fakes everywhere (dev + test)
NOD_FAKE_PROVIDERS="1"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Meta / Instagram (read-only scopes only — never a publish scope)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"

# BankID broker (Criipto sandbox)
BANKID_BROKER_DOMAIN=""
BANKID_BROKER_CLIENT_ID=""
BANKID_BROKER_CLIENT_SECRET=""
BANKID_SUBJECT_SALT="change-me-in-production-long-random-string"

# Email
RESEND_API_KEY=""
EMAIL_FROM="NOD <hello@nod.se>"
OPS_EMAIL="ops@nod.se"

# Web push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Analytics / errors
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
POSTHOG_KEY=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Ops alerts
SLACK_OPS_WEBHOOK_URL=""

# AES-256-GCM key for swishNumber + tokens. 32 bytes, base64.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
