# ---- Core ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (Supabase Postgres, EU region) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nod?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/nod?schema=public"

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nod-media"

# ---- Providers: when a key is absent the fake implementation is used ----
# Set NOD_FAKE_PROVIDERS=1 to force fakes everywhere (dev + test)
NOD_FAKE_PROVIDERS="1"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Inngest
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Meta / Instagram (read-only scopes only — never a publish scope)
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"

# BankID broker (Criipto sandbox)
BANKID_BROKER_DOMAIN=""
BANKID_BROKER_CLIENT_ID=""
BANKID_BROKER_CLIENT_SECRET=""
BANKID_SUBJECT_SALT="change-me-in-production-long-random-string"

# Email
RESEND_API_KEY=""
EMAIL_FROM="NOD <hello@nod.se>"
OPS_EMAIL="ops@nod.se"

# Web push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Analytics / errors
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
POSTHOG_KEY=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Ops alerts
SLACK_OPS_WEBHOOK_URL=""

# ---- Placement engine (docs/06 section 6) ----
# Chain: hosted inpaint (if configured) -> local composite (sharp, always on) -> ops queue.
# NOD_ENGINE forces one layer: hosted | local | ops | fake. Unset = best available.
# The DB flag engine.autoRender=false sends every render to the ops queue without a deploy.
NOD_ENGINE=""
# Set both INPAINT_* to switch on the hosted engine; it falls back to local on failure.
INPAINT_PROVIDER=""          # openai | stability | replicate
INPAINT_API_KEY=""
INPAINT_MODEL=""             # provider model or Replicate version id
INPAINT_ENDPOINT=""          # overrides the provider default
INPAINT_TIMEOUT_MS="90000"

# ---- M5: Swish Payouts API (docs/06 section 5) ----
# Absent -> ops exports a CSV and pays by hand. Needs a bank agreement + certificate.
SWISH_ENDPOINT=""
SWISH_PAYER_ALIAS=""         # NOD's Swish Företag number
SWISH_CERT_PATH=""           # client certificate for mutual TLS
SWISH_KEY_PATH=""
SWISH_CA_PATH=""
SWISH_CERT_PASSPHRASE=""
SWISH_SIGNING_KEY_PATH=""    # separate signing key; payouts are signed, not just TLS'd
SWISH_SIGNING_CERT_SERIAL=""
SWISH_CALLBACK_URL=""

# ---- SMS fallback (docs/06 section 7) ----
# Flag-gated in the DB as well (notify.smsFallbackEnabled) because it costs per message.
# Only campaign drop, claim expiring and approved-post-now may ever use it.
ELKS_USERNAME=""
ELKS_PASSWORD=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SMS_SENDER="NOD"

# ---- M5: market (docs/09 M5 task 7) ----
# SE (BankID) | DK (MitID) | NO (BankID) | FI. Selects the broker acr_values.
NOD_MARKET="SE"

# AES-256-GCM key for swishNumber + tokens. 32 bytes, base64.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Also signs the NOD_SESSION cookie issued by the email-code sign-in (lib/session.ts).
# Demo deploys only: show the sign-in code on the page when no mail provider is set.
NOD_DEMO_LOGIN_CODE=""
